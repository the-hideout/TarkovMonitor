<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(HasNickname
                ? "Update the nickname used to identify this EFT account."
                : "Set a nickname to identify this EFT account and all of its bound profiles.")
        </MudText>
        <MudTextField @bind-Value="nickname"
                      Immediate="true"
                      Label="Account nickname"
                      MaxLength="32"
                      Counter="32"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      AutoFocus="true" />
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Info" OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(nickname)">
            @(HasNickname ? "Save nickname" : "Set nickname")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public string ExistingNickname { get; set; } = "";

    private string nickname = "";
    private string errorMessage = "";
    private bool HasNickname => !string.IsNullOrWhiteSpace(ExistingNickname);

    protected override void OnInitialized()
    {
        nickname = ExistingNickname;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        var normalizedNickname = nickname.Trim();
        if (normalizedNickname.Length is < 1 or > 32 || normalizedNickname.Any(char.IsControl))
        {
            errorMessage = "Enter a nickname between 1 and 32 characters.";
            return;
        }
        MudDialog.Close(DialogResult.Ok(normalizedNickname));
    }
}
